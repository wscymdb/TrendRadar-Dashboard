FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai \
    DOCKER_CONTAINER=true

# 安装系统时区依赖并配置国内 pip 镜像源加速安装核心依赖
RUN apt-get update && apt-get install -y --no-install-recommends tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple pyyaml pytz requests litellm

# 复制爬虫内核、后台服务、默认配置以及编译好的 React 前端大屏产物
COPY trendradar/ /app/trendradar/
COPY docker/server.py /app/docker/server.py
COPY config/ /app/config/
COPY web/dist/ /app/web/dist/

# 预建输出与日志持久化目录
RUN mkdir -p /app/output/news /app/output/logs

EXPOSE 8080

CMD ["python", "docker/server.py"]
